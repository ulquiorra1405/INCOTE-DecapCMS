---
import Layout from '../../layouts/Page.astro';
import { Container, Button } from '@components/odyssey-theme';

const cursos = await Astro.glob('./*.md');

const seo = {
	title: 'Cursos y Capacitaciones — INCOTE',
	description: 'Conoce todos nuestros cursos técnicos certificados por INFOTEP. Formación práctica en Santo Domingo, Santiago y San Juan.',
};
---

<Layout {seo}>
	<Container>
		<section class="cursos-header">
			<h1>Cursos y Capacitaciones</h1>
			<p>Forma parte de INCOTE hoy mismo, contamos con cursos en muchas áreas y en distintos horarios para que puedas formarte a tu ritmo y en base a tu necesidad.</p>
		</section>

		<section class="cursos-grid">
			{
				cursos
					.sort((a, b) => (a.frontmatter.titulo || '').localeCompare(b.frontmatter.titulo || ''))
					.map(curso => {
						const { titulo, categoria, descripcion_corta, horario, duracion, modalidad, imagen, instructor, estudiantes } = curso.frontmatter;
						const slug = curso.url?.replace('/cursos/', '').replace('/', '') || '';
						return (
							<a href={`/cursos/${slug}`} class="curso-card-link">
								<article class="curso-card">
									{imagen && <div class="curso-card__img">
										<img src={imagen} alt={titulo} />
									</div>}
									<div class="curso-card__body">
										<span class="curso-card__categoria">{categoria}</span>
										<h2>{titulo}</h2>
										<p class="curso-card__desc">{descripcion_corta}</p>
										<div class="curso-card__info">
											{horario && <span>&#128197; {horario}</span>}
											{duracion && <span>&#9200; {duracion}</span>}
											{modalidad && <span>&#127760; {modalidad}</span>}
											{estudiantes && <span>&#128101; {estudiantes}</span>}
										</div>
										<Button unelevated>Ver más</Button>
									</div>
								</article>
							</a>
						);
					})
			}
		</section>
	</Container>
</Layout>

<style>
	.cursos-header {
		margin: var(--section-margin) auto;
		text-align: center;
		max-width: 700px;
	}
	.cursos-header h1 {
		margin-bottom: 1rem;
	}
	.cursos-header p {
		opacity: 0.7;
		font-size: 1.05rem;
		line-height: 1.6;
	}

	.cursos-grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 1.5rem;
		margin: var(--section-margin) auto;
	}
	.curso-card-link {
		text-decoration: none;
		color: inherit;
	}
	.curso-card {
		border-radius: var(--theme-shape-radius);
		overflow: hidden;
		background: var(--theme-surface-1);
		transition: transform 0.2s ease, box-shadow 0.2s ease;
		height: 100%;
		display: flex;
		flex-direction: column;
	}
	.curso-card:hover {
		transform: translateY(-4px);
		box-shadow: 0 8px 24px rgba(0,0,0,0.12);
	}
	.curso-card__img {
		height: 200px;
		overflow: hidden;
	}
	.curso-card__img img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}
	.curso-card__body {
		padding: 1.5rem;
		flex: 1;
		display: flex;
		flex-direction: column;
	}
	.curso-card__categoria {
		display: inline-block;
		background: var(--theme-primary);
		color: var(--theme-on-primary);
		padding: 0.2rem 0.6rem;
		border-radius: 0.25rem;
		font-size: 0.75rem;
		font-weight: 600;
		margin-bottom: 0.5rem;
		text-transform: uppercase;
		width: fit-content;
	}
	.curso-card__body h2 {
		font-size: 1.15rem;
		margin-bottom: 0.5rem;
	}
	.curso-card__desc {
		font-size: 0.9rem;
		opacity: 0.7;
		margin-bottom: 1rem;
		line-height: 1.5;
		flex: 1;
	}
	.curso-card__info {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 0.35rem;
		font-size: 0.8rem;
		opacity: 0.65;
		margin-bottom: 1rem;
	}
	.curso-card__info span {
		padding: 0.2rem 0;
	}

	@media (max-width: 768px) {
		.cursos-grid {
			grid-template-columns: 1fr;
		}
		.curso-card__info {
			grid-template-columns: 1fr;
		}
	}
</style>
