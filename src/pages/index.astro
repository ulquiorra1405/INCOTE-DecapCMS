---
import { Container, FeatureCard, Button, TextSection, CustomerQuoteSection, CtaCardSection, ThreeColumnTextSection } from '@components/odyssey-theme';
import Layout from '../layouts/Page.astro';
import HomeHeroSection from '../components/sections/heros/HomeHeroSection.astro';
---

<Layout>
	<HomeHeroSection />

	<!-- Stats Section -->
	<Container>
		<section class="stats-section">
			<div class="stat-card">
				<span class="stat-number">+500</span>
				<span class="stat-label">Estudiantes activos</span>
			</div>
			<div class="stat-card">
				<span class="stat-number">+20</span>
				<span class="stat-label">Cursos y capacitaciones</span>
			</div>
			<div class="stat-card">
				<span class="stat-number">+50</span>
				<span class="stat-label">Horas de enseñanza</span>
				<span class="stat-sub">mil</span>
			</div>
			<div class="stat-card">
				<span class="stat-number">+40</span>
				<span class="stat-label">Años de servicio</span>
			</div>
		</section>
	</Container>

	<!-- ¿Por qué INCOTE? -->
	<Container>
		<section class="why-section">
			<div class="section-label">¿Por qué nosotros?</div>
			<h2>¿Por qué los estudiantes nos eligen?</h2>
			<div class="why-grid">
				<div class="why-card">
					<div class="why-icon-wrapper">
						<span class="why-icon">&#x1F393;</span>
					</div>
					<h3>Certificación INFOTEP</h3>
					<p>Todos nuestros cursos están certificados por INFOTEP, lo que avala tu aprendizaje ante instituciones y empleadores.</p>
				</div>
				<div class="why-card">
					<div class="why-icon-wrapper">
						<span class="why-icon">&#x1F468;&#x200D;&#x1F3EB;</span>
					</div>
					<h3>Instructores Calificados</h3>
					<p>Contamos con personal altamente capacitado e instruido en cada una de sus áreas.</p>
				</div>
				<div class="why-card">
					<div class="why-icon-wrapper">
						<span class="why-icon">&#x1F4F1;</span>
					</div>
					<h3>Plataformas Digitales</h3>
					<p>Aprende desde cualquier lugar con nuestras plataformas digitales y horarios flexibles.</p>
				</div>
				<div class="why-card">
					<div class="why-icon-wrapper">
						<span class="why-icon">&#x1F3E2;</span>
					</div>
					<h3>Infraestructura</h3>
					<p>Instalaciones cómodas y equipadas para que te enfoques en aprender en nuestras 3 sucursales.</p>
				</div>
			</div>
		</section>
	</Container>

	<!-- Cursos Destacados -->
	<Container>
		<section class="feature-card__section">
			<div class="section-label">Nuestra oferta</div>
			<h2>Cursos Destacados</h2>
			<p class="section-subtitle">Los cursos más buscados y elegidos por nuestros estudiantes.</p>
			<div class="feature-card__grid">
				<a href="/cursos/cosmiatria-basica-y-avanzada" class="curso-card-link">
					<article class="curso-card">
						<div class="curso-card__image">
							<img src="/assets/images/cursos/cosmiatria.jpg" alt="Cosmiatría" />
							<span class="curso-card__categoria">Estética</span>
						</div>
						<div class="curso-card__body">
							<h3>Cosmiatría Básica y Avanzada</h3>
							<p class="curso-card__desc">Limpieza facial, tratamientos estéticos avanzados.</p>
							<div class="curso-card__info">
								<span>&#128197; Domingos, 8:00 a.m.</span>
								<span>&#9200; 3 meses (50 horas)</span>
							</div>
							<span class="curso-card__link">Ver curso &#8594;</span>
						</div>
					</article>
				</a>
				<a href="/cursos/diseno-grafico-101" class="curso-card-link">
					<article class="curso-card">
						<div class="curso-card__image">
							<img src="/assets/images/cursos/diseno-grafico.jpg" alt="Diseño Gráfico" />
							<span class="curso-card__categoria">Diseño</span>
						</div>
						<div class="curso-card__body">
							<h3>Diseño Gráfico 101</h3>
							<p class="curso-card__desc">Photoshop e Illustrator, diseño visual para redes.</p>
							<div class="curso-card__info">
								<span>&#128197; Sábados, 9:00 a.m.</span>
								<span>&#9200; 3 meses (50 horas)</span>
							</div>
							<span class="curso-card__link">Ver curso &#8594;</span>
						</div>
					</article>
				</a>
				<a href="/cursos/barberia" class="curso-card-link">
					<article class="curso-card">
						<div class="curso-card__image">
							<img src="/assets/images/cursos/barberia.jpg" alt="Barbería" />
							<span class="curso-card__categoria">Estética</span>
						</div>
						<div class="curso-card__body">
							<h3>Barbería</h3>
							<p class="curso-card__desc">Técnicas de corte y afeitado modernas.</p>
							<div class="curso-card__info">
								<span>&#128197; Sábados, 9:00 a.m.</span>
								<span>&#9200; 3 meses</span>
							</div>
							<span class="curso-card__link">Ver curso &#8594;</span>
						</div>
					</article>
				</a>
			</div>
			<div class="cta-center">
				<Button href="/cursos">Ver Todos los Cursos</Button>
			</div>
		</section>
	</Container>

	<!-- Separator wave -->
	<div class="section-divider">
		<svg viewBox="0 0 1440 60" preserveAspectRatio="none"><path d="M0,30 C360,60 720,0 1440,30 L1440,60 L0,60 Z" fill="var(--theme-surface-1)"/></svg>
	</div>

	<!-- Instructores -->
	<Container>
		<section class="instructors-section">
			<div class="section-label">Equipo</div>
			<h2>Conoce a nuestros capacitadores</h2>
			<div class="instructors-grid">
				<div class="instructor-card">
					<div class="instructor-avatar" style="background: var(--theme-gradient-primary);">TL</div>
					<h3>Tadaichi Lopez</h3>
					<span class="instructor-area">Inglés</span>
				</div>
				<div class="instructor-card">
					<div class="instructor-avatar" style="background: var(--theme-gradient-accent); color: var(--theme-on-accent);">JM</div>
					<h3>Jennelly Martínez</h3>
					<span class="instructor-area">Farmacia y Visitador a Médico</span>
				</div>
				<div class="instructor-card">
					<div class="instructor-avatar" style="background: var(--theme-gradient-primary);">SH</div>
					<h3>Sulem Hilario</h3>
					<span class="instructor-area">Secretariado</span>
				</div>
				<div class="instructor-card">
					<div class="instructor-avatar" style="background: var(--theme-gradient-accent); color: var(--theme-on-accent);">CV</div>
					<h3>Carmen Vega</h3>
					<span class="instructor-area">Ventas y Emprendedurismo</span>
				</div>
			</div>
		</section>
	</Container>

	<!-- Testimonios -->
	<Container>
		<section class="testimonials-section">
			<div class="section-label">Testimonios</div>
			<h2>¿Qué dicen nuestros alumnos?</h2>
			<div class="testimonials-grid">
				<blockquote class="testimonial-card">
					<div class="testimonial-stars">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
					<p>"¡Fue lo mejor! Mis amigas y mi profesora compartíamos muchas cosas juntas, éramos una familia numerosa y nos queríamos mucho. ¡Me encantó!"</p>
					<footer>
						<strong>Susana Reynoso</strong>
						<span>Estudiante</span>
					</footer>
				</blockquote>
				<blockquote class="testimonial-card">
					<div class="testimonial-stars">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
					<p>"Excelente institución para la formación en la modalidad técnica."</p>
					<footer>
						<strong>Dr. Carlos Alfredo Muñoz</strong>
						<span>Estudiante</span>
					</footer>
				</blockquote>
			</div>
		</section>
	</Container>

	<!-- CTA Final -->
	<Container>
		<section class="cta-final">
			<h2>¿Listo para empezar tu formación?</h2>
			<p>Forma parte de INCOTE hoy mismo. Contamos con cursos en muchas áreas y en distintos horarios para que puedas formarte a tu ritmo.</p>
			<Button href="/contacto" size="large" onPrimary>Contáctanos</Button>
		</section>
	</Container>
</Layout>

<style>
	/* Section Label */
	.section-label {
		display: inline-block;
		color: var(--theme-accent);
		font-size: 0.8rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		margin-bottom: 0.5rem;
	}
	.section-subtitle {
		font-size: 1.05rem;
		opacity: 0.7;
		margin-bottom: 2.5rem;
		max-width: 500px;
	}

	/* Stats */
	.stats-section {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: 1.5rem;
		margin: var(--section-margin) auto;
		text-align: center;
	}
	.stat-card {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		padding: 2.5rem 1rem;
		background: var(--theme-surface-1);
		border-radius: var(--theme-shape-radius);
		box-shadow: var(--theme-shadow-sm);
		transition: transform var(--theme-transition), box-shadow var(--theme-transition);
	}
	.stat-card:hover {
		transform: translateY(-4px);
		box-shadow: var(--theme-shadow-md);
	}
	.stat-number {
		font-size: 2.5rem;
		font-weight: 800;
		color: var(--theme-primary);
		font-family: var(--theme-font-family-serif);
		line-height: 1;
		margin-bottom: 0.25rem;
	}
	.stat-label {
		font-size: 0.85rem;
		opacity: 0.7;
	}
	.stat-sub {
		font-size: 0.7rem;
		opacity: 0.5;
		margin-top: -0.25rem;
	}

	/* Why */
	.why-section {
		margin: var(--section-margin) auto;
		text-align: center;
	}
	.why-section h2 {
		margin-bottom: 3rem;
	}
	.why-grid {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: 1.5rem;
	}
	.why-card {
		padding: 2.5rem 1.5rem;
		background: var(--theme-bg);
		border-radius: var(--theme-shape-radius);
		text-align: center;
		box-shadow: var(--theme-shadow-sm);
		border: 1px solid rgba(0,0,0,0.04);
		transition: transform var(--theme-transition-slow), box-shadow var(--theme-transition-slow);
	}
	.why-card:hover {
		transform: translateY(-6px);
		box-shadow: var(--theme-shadow-lg);
	}
	.why-icon-wrapper {
		width: 60px;
		height: 60px;
		border-radius: 50%;
		background: var(--theme-surface-2);
		display: flex;
		align-items: center;
		justify-content: center;
		margin: 0 auto 1.25rem;
	}
	.why-icon {
		font-size: 1.5rem;
	}
	.why-card h3 {
		margin-bottom: 0.75rem;
		font-size: 1.05rem;
	}
	.why-card p {
		font-size: 0.9rem;
		opacity: 0.7;
		line-height: 1.6;
	}

	/* Featured Courses */
	.feature-card__section {
		margin: var(--section-margin) auto;
	}
	.feature-card__section h2 {
		margin-bottom: 0.25rem;
	}
	.feature-card__grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: var(--theme-grid-gap);
	}
	.curso-card-link {
		text-decoration: none;
		color: inherit;
	}
	.curso-card {
		border-radius: var(--theme-shape-radius);
		overflow: hidden;
		background: var(--theme-bg);
		box-shadow: var(--theme-shadow-sm);
		transition: transform var(--theme-transition-slow), box-shadow var(--theme-transition-slow);
		height: 100%;
		display: flex;
		flex-direction: column;
		border: 1px solid rgba(0,0,0,0.04);
	}
	.curso-card:hover {
		transform: translateY(-6px);
		box-shadow: var(--theme-shadow-lg);
	}
	.curso-card__image {
		height: 200px;
		overflow: hidden;
		position: relative;
	}
	.curso-card__image img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform var(--theme-transition-slow);
	}
	.curso-card:hover .curso-card__image img {
		transform: scale(1.05);
	}
	.curso-card__categoria {
		position: absolute;
		bottom: 0.75rem;
		left: 0.75rem;
		display: inline-block;
		background: var(--theme-gradient-primary);
		color: #fff;
		padding: 0.3rem 0.8rem;
		border-radius: 0.5rem;
		font-size: 0.7rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.05em;
	}
	.curso-card__body {
		padding: 1.5rem;
		flex: 1;
		display: flex;
		flex-direction: column;
	}
	.curso-card__body h3 {
		font-size: 1.1rem;
		margin-bottom: 0.5rem;
	}
	.curso-card__desc {
		font-size: 0.85rem;
		opacity: 0.65;
		margin-bottom: 1rem;
		line-height: 1.5;
		flex: 1;
	}
	.curso-card__info {
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
		font-size: 0.8rem;
		opacity: 0.6;
		margin-bottom: 1rem;
	}
	.curso-card__link {
		font-size: 0.85rem;
		font-weight: 600;
		color: var(--theme-primary);
		transition: gap var(--theme-transition);
		display: inline-flex;
		align-items: center;
		gap: 0.25rem;
	}
	.curso-card:hover .curso-card__link {
		gap: 0.5rem;
	}
	.cta-center {
		text-align: center;
		margin-top: 2.5rem;
	}

	/* Section Divider */
	.section-divider {
		margin: 0;
		line-height: 0;
	}
	.section-divider svg {
		width: 100%;
		height: 60px;
		display: block;
	}

	/* Instructors */
	.instructors-section {
		margin: var(--section-margin) auto;
		text-align: center;
	}
	.instructors-section h2 {
		margin-bottom: 3rem;
	}
	.instructors-grid {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: 1.5rem;
	}
	.instructor-card {
		padding: 2rem 1.5rem;
		background: var(--theme-bg);
		border-radius: var(--theme-shape-radius);
		text-align: center;
		box-shadow: var(--theme-shadow-sm);
		border: 1px solid rgba(0,0,0,0.04);
		transition: transform var(--theme-transition), box-shadow var(--theme-transition);
	}
	.instructor-card:hover {
		transform: translateY(-4px);
		box-shadow: var(--theme-shadow-md);
	}
	.instructor-avatar {
		width: 80px;
		height: 80px;
		border-radius: 50%;
		margin: 0 auto 1.25rem;
		display: flex;
		align-items: center;
		justify-content: center;
		color: #fff;
		font-size: 1.5rem;
		font-weight: 700;
		font-family: var(--theme-font-family-serif);
	}
	.instructor-card h3 {
		font-size: 1rem;
		margin-bottom: 0.25rem;
	}
	.instructor-area {
		font-size: 0.85rem;
		opacity: 0.65;
	}

	/* Testimonials */
	.testimonials-section {
		margin: var(--section-margin) auto;
		text-align: center;
	}
	.testimonials-section h2 {
		margin-bottom: 3rem;
	}
	.testimonials-grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 1.5rem;
	}
	.testimonial-card {
		padding: 2.5rem;
		background: var(--theme-bg);
		border-radius: var(--theme-shape-radius);
		text-align: left;
		margin: 0;
		box-shadow: var(--theme-shadow-sm);
		border: 1px solid rgba(0,0,0,0.04);
		position: relative;
	}
	.testimonial-card::before {
		content: '"';
		position: absolute;
		top: 1rem;
		left: 1.5rem;
		font-size: 4rem;
		line-height: 1;
		color: var(--theme-accent);
		opacity: 0.15;
		font-family: var(--theme-font-family-serif);
	}
	.testimonial-stars {
		color: var(--theme-accent);
		font-size: 1rem;
		margin-bottom: 1rem;
		letter-spacing: 0.15em;
	}
	.testimonial-card p {
		font-style: italic;
		font-size: 1rem;
		line-height: 1.7;
		margin-bottom: 1.5rem;
		position: relative;
		z-index: 1;
	}
	.testimonial-card footer strong {
		display: block;
		font-size: 0.9rem;
	}
	.testimonial-card footer span {
		font-size: 0.8rem;
		opacity: 0.55;
	}

	/* CTA Final */
	.cta-final {
		margin: var(--section-margin) auto;
		padding: 5rem 2rem;
		background: var(--theme-gradient-primary);
		border-radius: var(--theme-shape-radius);
		text-align: center;
		position: relative;
		overflow: hidden;
	}
	.cta-final::before {
		content: '';
		position: absolute;
		inset: 0;
		background: radial-gradient(circle at 20% 80%, rgba(245,197,24,0.1) 0%, transparent 50%),
		            radial-gradient(circle at 80% 20%, rgba(255,255,255,0.05) 0%, transparent 50%);
	}
	.cta-final h2 {
		font-size: 2rem;
		margin-bottom: 1rem;
		color: #fff;
		position: relative;
	}
	.cta-final p {
		max-width: 550px;
		margin: 0 auto 2rem;
		opacity: 0.8;
		color: rgba(255,255,255,0.9);
		position: relative;
	}

	/* Responsive */
	@media (max-width: 768px) {
		.stats-section { grid-template-columns: repeat(2, 1fr); }
		.why-grid { grid-template-columns: repeat(2, 1fr); }
		.feature-card__grid { grid-template-columns: 1fr; }
		.instructors-grid { grid-template-columns: repeat(2, 1fr); }
		.testimonials-grid { grid-template-columns: 1fr; }
	}
	@media (max-width: 480px) {
		.stats-section { grid-template-columns: 1fr; }
		.why-grid { grid-template-columns: 1fr; }
		.instructors-grid { grid-template-columns: 1fr; }
	}
</style>
