---
import { Container, FeatureCard, Button, TextSection, CustomerQuoteSection, CtaCardSection, ThreeColumnTextSection } from '@components/odyssey-theme';
import Layout from '../layouts/Page.astro';
import HomeHeroSection from '../components/sections/heros/HomeHeroSection.astro';
---

<Layout>
	<HomeHeroSection />

	<!-- Stats Section -->
	<Container>
		<section class="stats-section">
			<div class="stat-card">
				<span class="stat-number">+500</span>
				<span class="stat-label">Estudiantes activos</span>
			</div>
			<div class="stat-card">
				<span class="stat-number">+20</span>
				<span class="stat-label">Cursos y capacitaciones</span>
			</div>
			<div class="stat-card">
				<span class="stat-number">+50</span>
				<span class="stat-label">Horas de enseñanza</span>
				<span class="stat-sub">mil</span>
			</div>
			<div class="stat-card">
				<span class="stat-number">+40</span>
				<span class="stat-label">Años de servicio</span>
			</div>
		</section>
	</Container>

	<!-- ¿Por qué INCOTE? -->
	<Container>
		<section class="why-section">
			<h2>¿Por qué los estudiantes nos eligen?</h2>
			<div class="why-grid">
				<div class="why-card">
					<span class="why-icon">&#x1F393;</span>
					<h3>Certificación INFOTEP</h3>
					<p>Todos nuestros cursos están certificados por INFOTEP, lo que avala tu aprendizaje ante instituciones y empleadores.</p>
				</div>
				<div class="why-card">
					<span class="why-icon">&#x1F468;&#x200D;&#x1F3EB;</span>
					<h3>Instructores Calificados</h3>
					<p>Contamos con personal altamente capacitado e instruido en cada una de sus áreas.</p>
				</div>
				<div class="why-card">
					<span class="why-icon">&#x1F4F1;</span>
					<h3>Plataformas Digitales</h3>
					<p>Aprende desde cualquier lugar con nuestras plataformas digitales y horarios flexibles.</p>
				</div>
				<div class="why-card">
					<span class="why-icon">&#x1F3E2;</span>
					<h3>Infraestructura</h3>
					<p>Instalaciones cómodas y equipadas para que te enfoques en aprender en nuestras 3 sucursales.</p>
				</div>
			</div>
		</section>
	</Container>

	<!-- Cursos Destacados -->
	<Container>
		<section class="feature-card__section">
			<h2>Cursos Destacados</h2>
			<p>Los cursos más buscados y elegidos por nuestros estudiantes.</p>
			<div class="feature-card__grid">
				<div class="curso-card">
					<div class="curso-card__image">
						<img src="/assets/images/placeholder-screenshot.png" alt="Cosmiatría" />
					</div>
					<div class="curso-card__body">
						<span class="curso-card__categoria">Estética</span>
						<h3>Cosmiatría Básica y Avanzada</h3>
						<p class="curso-card__desc">Limpieza facial, tratamientos estéticos avanzados.</p>
						<div class="curso-card__meta">
							<span>Domingos, 8:00 a.m.</span>
							<span>3 meses (50 horas)</span>
						</div>
						<Button href="/cursos/cosmiatria-basica-y-avanzada" unelevated>Ver más</Button>
					</div>
				</div>
				<div class="curso-card">
					<div class="curso-card__image">
						<img src="/assets/images/placeholder-screenshot.png" alt="Diseño Gráfico" />
					</div>
					<div class="curso-card__body">
						<span class="curso-card__categoria">Diseño</span>
						<h3>Diseño Gráfico 101</h3>
						<p class="curso-card__desc">Photoshop e Illustrator, diseño visual para redes.</p>
						<div class="curso-card__meta">
							<span>Sábados, 9:00 a.m.</span>
							<span>3 meses (50 horas)</span>
						</div>
						<Button href="/cursos/diseno-grafico-101" unelevated>Ver más</Button>
					</div>
				</div>
				<div class="curso-card">
					<div class="curso-card__image">
						<img src="/assets/images/placeholder-screenshot.png" alt="Barbería" />
					</div>
					<div class="curso-card__body">
						<span class="curso-card__categoria">Estética</span>
						<h3>Barbería</h3>
						<p class="curso-card__desc">Técnicas de corte y afeitado modernas.</p>
						<div class="curso-card__meta">
							<span>Sábados, 9:00 a.m.</span>
							<span>3 meses</span>
						</div>
						<Button href="/cursos/barberia" unelevated>Ver más</Button>
					</div>
				</div>
			</div>
			<div class="cta-center">
				<Button href="/cursos">Ver Todos los Cursos</Button>
			</div>
		</section>
	</Container>

	<!-- Instructores -->
	<Container>
		<section class="instructors-section">
			<h2>Conoce a nuestros capacitadores</h2>
			<div class="instructors-grid">
				<div class="instructor-card">
					<div class="instructor-avatar">
						<img src="/assets/images/home/screenshots/contact" alt="Tadaichi Lopez" />
					</div>
					<h3>Tadaichi Lopez</h3>
					<span class="instructor-area">Inglés</span>
				</div>
				<div class="instructor-card">
					<div class="instructor-avatar">
						<img src="/assets/images/home/screenshots/about" alt="Jennelly Martínez" />
					</div>
					<h3>Jennelly Martínez</h3>
					<span class="instructor-area">Farmacia y Visitador a Médico</span>
				</div>
				<div class="instructor-card">
					<div class="instructor-avatar">
						<img src="/assets/images/home/screenshots/legal" alt="Sulem Hilario" />
					</div>
					<h3>Sulem Hilario</h3>
					<span class="instructor-area">Secretariado</span>
				</div>
				<div class="instructor-card">
					<div class="instructor-avatar">
						<img src="/assets/images/home/screenshots/blog-post" alt="Carmen Vega" />
					</div>
					<h3>Carmen Vega</h3>
					<span class="instructor-area">Ventas y Emprendedurismo</span>
				</div>
			</div>
		</section>
	</Container>

	<!-- Testimonios -->
	<Container>
		<section class="testimonials-section">
			<h2>¿Qué dicen nuestros alumnos?</h2>
			<div class="testimonials-grid">
				<blockquote class="testimonial-card">
					<p>¡Fue lo mejor! Mis amigas y mi profesora compartíamos muchas cosas juntas, éramos una familia numerosa y nos queríamos mucho. ¡Me encantó!</p>
					<footer>
						<strong>Susana Reynoso</strong>
						<span>Estudiante</span>
					</footer>
				</blockquote>
				<blockquote class="testimonial-card">
					<p>Excelente institución para la formación en la modalidad técnica.</p>
					<footer>
						<strong>Dr. Carlos Alfredo Muñoz</strong>
						<span>Estudiante</span>
					</footer>
				</blockquote>
			</div>
		</section>
	</Container>

	<!-- CTA Final -->
	<Container>
		<section class="cta-final">
			<h2>¿Listo para empezar tu formación?</h2>
			<p>Forma parte de INCOTE hoy mismo. Contamos con cursos en muchas áreas y en distintos horarios para que puedas formarte a tu ritmo.</p>
			<Button href="/contacto" size="large">Contáctanos</Button>
		</section>
	</Container>
</Layout>

<style>
	/* Stats */
	.stats-section {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: 1.5rem;
		margin: var(--section-margin) auto;
		text-align: center;
	}
	.stat-card {
		display: flex;
		flex-direction: column;
		align-items: center;
		padding: 2rem 1rem;
		background: var(--theme-surface-1);
		border-radius: var(--theme-shape-radius);
	}
	.stat-number {
		font-size: 2.5rem;
		font-weight: 700;
		color: var(--theme-primary);
		font-family: var(--theme-font-family-serif);
	}
	.stat-label {
		font-size: 0.9rem;
		opacity: 0.8;
	}
	.stat-sub {
		font-size: 0.75rem;
		opacity: 0.6;
	}

	/* Why */
	.why-section {
		margin: var(--section-margin) auto;
		text-align: center;
	}
	.why-section h2 {
		margin-bottom: 2rem;
	}
	.why-grid {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: 1.5rem;
	}
	.why-card {
		padding: 2rem 1rem;
		background: var(--theme-surface-1);
		border-radius: var(--theme-shape-radius);
		text-align: center;
	}
	.why-icon {
		font-size: 2.5rem;
		display: block;
		margin-bottom: 1rem;
	}
	.why-card h3 {
		margin-bottom: 0.5rem;
		font-size: 1.1rem;
	}
	.why-card p {
		font-size: 0.9rem;
		opacity: 0.8;
	}

	/* Featured Courses */
	.feature-card__section {
		margin: var(--section-margin) auto;
	}
	.feature-card__section h2 {
		margin-bottom: 0.5rem;
	}
	.feature-card__section > p {
		margin-bottom: 2rem;
		opacity: 0.7;
	}
	.feature-card__grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: var(--theme-grid-gap);
	}
	.curso-card {
		border-radius: var(--theme-shape-radius);
		overflow: hidden;
		background: var(--theme-surface-1);
		transition: transform 0.2s ease, box-shadow 0.2s ease;
	}
	.curso-card:hover {
		transform: translateY(-4px);
		box-shadow: 0 8px 24px rgba(0,0,0,0.12);
	}
	.curso-card__image {
		height: 180px;
		overflow: hidden;
	}
	.curso-card__image img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}
	.curso-card__body {
		padding: 1.25rem;
	}
	.curso-card__categoria {
		display: inline-block;
		background: var(--theme-primary);
		color: var(--theme-on-primary);
		padding: 0.2rem 0.6rem;
		border-radius: 0.25rem;
		font-size: 0.75rem;
		font-weight: 600;
		margin-bottom: 0.5rem;
		text-transform: uppercase;
	}
	.curso-card__body h3 {
		font-size: 1.1rem;
		margin-bottom: 0.25rem;
	}
	.curso-card__rating {
		color: var(--theme-accent);
		font-size: 0.85rem;
		margin-bottom: 0.25rem;
	}
	.curso-card__instructor {
		font-size: 0.85rem;
		opacity: 0.7;
		margin-bottom: 0.5rem;
	}
	.curso-card__meta {
		display: flex;
		justify-content: space-between;
		font-size: 0.8rem;
		opacity: 0.6;
		margin-bottom: 1rem;
	}
	.cta-center {
		text-align: center;
		margin-top: 2rem;
	}

	/* Instructors */
	.instructors-section {
		margin: var(--section-margin) auto;
		text-align: center;
	}
	.instructors-section h2 {
		margin-bottom: 2rem;
	}
	.instructors-grid {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: 1.5rem;
	}
	.instructor-card {
		padding: 1.5rem;
		background: var(--theme-surface-1);
		border-radius: var(--theme-shape-radius);
		text-align: center;
	}
	.instructor-avatar {
		width: 80px;
		height: 80px;
		border-radius: 50%;
		overflow: hidden;
		margin: 0 auto 1rem;
		border: 3px solid var(--theme-accent);
	}
	.instructor-avatar img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}
	.instructor-card h3 {
		font-size: 1rem;
		margin-bottom: 0.25rem;
	}
	.instructor-area {
		font-size: 0.85rem;
		opacity: 0.7;
	}

	/* Testimonials */
	.testimonials-section {
		margin: var(--section-margin) auto;
		text-align: center;
	}
	.testimonials-section h2 {
		margin-bottom: 2rem;
	}
	.testimonials-grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 1.5rem;
	}
	.testimonial-card {
		padding: 2rem;
		background: var(--theme-surface-1);
		border-radius: var(--theme-shape-radius);
		text-align: left;
		border-left: 4px solid var(--theme-accent);
		margin: 0;
	}
	.testimonial-card p {
		font-style: italic;
		margin-bottom: 1rem;
	}
	.testimonial-card footer strong {
		display: block;
		font-size: 0.9rem;
	}
	.testimonial-card footer span {
		font-size: 0.8rem;
		opacity: 0.6;
	}

	/* CTA Final */
	.cta-final {
		margin: var(--section-margin) auto;
		padding: 4rem 2rem;
		background: var(--theme-primary);
		color: var(--theme-on-primary);
		border-radius: var(--theme-shape-radius);
		text-align: center;
	}
	.cta-final h2 {
		font-size: 2rem;
		margin-bottom: 1rem;
	}
	.cta-final p {
		max-width: 600px;
		margin: 0 auto 2rem;
		opacity: 0.85;
	}

	/* Responsive */
	@media (max-width: 768px) {
		.stats-section { grid-template-columns: repeat(2, 1fr); }
		.why-grid { grid-template-columns: repeat(2, 1fr); }
		.feature-card__grid { grid-template-columns: 1fr; }
		.instructors-grid { grid-template-columns: repeat(2, 1fr); }
		.testimonials-grid { grid-template-columns: 1fr; }
	}
	@media (max-width: 480px) {
		.stats-section { grid-template-columns: 1fr; }
		.why-grid { grid-template-columns: 1fr; }
		.instructors-grid { grid-template-columns: 1fr; }
	}
</style>
