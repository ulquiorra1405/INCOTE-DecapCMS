---
import Layout from '../layouts/Page.astro';
import { Container, Button } from '@components/odyssey-theme';

const seo = {
	title: 'Contacto — INCOTE',
	description: 'Comunícate con INCOTE. Estamos en Santo Domingo, Santiago y San Juan de la Maguana.',
};
---

<Layout {seo}>
	<Container>
		<section class="contact-header">
			<h1>Contáctanos</h1>
			<p>Estamos listos para atenderte. Elige la sucursal más cercana o escríbenos.</p>
		</section>
	</Container>

	<Container>
		<section class="contact-grid">
			<div class="contact-card">
				<div class="contact-icon">&#x1F3E2;</div>
				<h3>Santo Domingo</h3>
				<p>Av. San Vicente de Paúl 110, Santo Domingo Este</p>
				<p class="contact-phone">&#x1F4DE; (809) 788-1353</p>
			</div>
			<div class="contact-card">
				<div class="contact-icon">&#x1F3E2;</div>
				<h3>Santiago</h3>
				<p>Calle Gral. Luperón No.67, Centro de la Ciudad</p>
				<p class="contact-phone">&#x1F4DE; (809) 724-1414</p>
			</div>
			<div class="contact-card">
				<div class="contact-icon">&#x1F3E2;</div>
				<h3>San Juan de la Maguana</h3>
				<p>Sucursal principal, fundada en 1984</p>
				<p class="contact-phone">&#x1F4DE; (809) 557-1066</p>
			</div>
			<div class="contact-card contact-card--wide">
				<div class="contact-icon">&#x1F4E7;</div>
				<h3>Email</h3>
				<p>infoincote@gmail.com</p>
			</div>
		</section>
	</Container>

	<Container>
		<section class="contact-cta">
			<h2>¿Listo para empezar tu formación?</h2>
			<p>Forma parte de INCOTE hoy mismo. Llámanos, escríbenos o visita cualquiera de nuestras sucursales.</p>
			<div class="contact-cta__btns">
				<Button href="tel:+18097881353">Llamar a Santo Domingo</Button>
				<Button href="mailto:infoincote@gmail.com" unelevated>Enviar Email</Button>
			</div>
		</section>
	</Container>
</Layout>

<style>
	.contact-header {
		margin: var(--section-margin) auto;
		text-align: center;
		max-width: 600px;
	}
	.contact-header h1 {
		margin-bottom: 1rem;
	}
	.contact-header p {
		opacity: 0.7;
		font-size: 1.05rem;
	}

	.contact-grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 1.5rem;
		margin: var(--section-margin) auto;
	}
	.contact-card {
		padding: 2rem;
		background: var(--theme-surface-1);
		border-radius: var(--theme-shape-radius);
		text-align: center;
	}
	.contact-card--wide {
		grid-column: 1 / -1;
		max-width: 400px;
		justify-self: center;
		width: 100%;
	}
	.contact-icon {
		font-size: 2.5rem;
		margin-bottom: 1rem;
	}
	.contact-card h3 {
		margin-bottom: 0.5rem;
	}
	.contact-card p {
		font-size: 0.95rem;
		opacity: 0.8;
		line-height: 1.5;
		margin-bottom: 0.25rem;
	}
	.contact-phone {
		font-weight: 600;
		font-size: 1.05rem !important;
		opacity: 1 !important;
		color: var(--theme-primary);
		margin-top: 0.5rem;
	}

	.contact-cta {
		margin: var(--section-margin) auto;
		padding: 4rem 2rem;
		background: var(--theme-primary);
		color: var(--theme-on-primary);
		border-radius: var(--theme-shape-radius);
		text-align: center;
	}
	.contact-cta h2 {
		font-size: 2rem;
		margin-bottom: 1rem;
	}
	.contact-cta p {
		max-width: 500px;
		margin: 0 auto 2rem;
		opacity: 0.85;
	}
	.contact-cta__btns {
		display: flex;
		gap: 1rem;
		justify-content: center;
		flex-wrap: wrap;
	}

	@media (max-width: 600px) {
		.contact-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
