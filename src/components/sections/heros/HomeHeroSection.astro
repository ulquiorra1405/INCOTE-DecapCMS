---
import { Icon } from 'astro-icon/components';
import { Container, Button } from '@components/odyssey-theme';
---

<Container>
	<section class="hero-section__section">
		<div class="hero-section__bg"></div>
		<div class="hero-section__content">
			<div class="hero-section__text">
				<span class="hero-badge">Formación técnica certificada por INFOTEP</span>
				<h1>Prepárate e intégrate<br />al mundo laboral</h1>
				<p>
					INCOTE te ofrece cursos técnicos certificados en múltiples áreas. 
					Formación práctica con horarios flexibles en Santo Domingo, Santiago y San Juan.
				</p>
				<div class="hero-btns__container">
					<Button href="/cursos" customIcon>
						Ver Cursos
            <Fragment slot="icon">
              <Icon name="ic:baseline-chevron-right"/>
            </Fragment>
          </Button>
					<Button href="/nosotros" unelevated>Conócenos</Button>
				</div>
			</div>
			<div class="hero-section__image">
				<div class="hero-image-wrapper">
					<div class="hero-image-decoration"></div>
					<picture>
						<img
							src="/assets/images/home/classic-hero.jpg"
							alt="INCOTE — Instituto Técnico Comercial"
							id="home-hero-image"
						/>
					</picture>
				</div>
			</div>
		</div>
	</section>
</Container>

<style>
	.hero-section__section {
		margin: var(--section-margin) auto;
		min-height: clamp(85vh, 90vw, calc(100vh - var(--navbar-height)));
		position: relative;
		overflow: hidden;
		border-radius: var(--theme-shape-radius);
	}

	.hero-section__bg {
		position: absolute;
		inset: 0;
		background: var(--theme-gradient-hero);
		border-radius: var(--theme-shape-radius);
		z-index: 0;
	}

	.hero-section__content {
		position: relative;
		z-index: 1;
		display: grid;
		grid-template-columns: 1fr 1fr;
		align-items: center;
		gap: 2rem;
		padding: 3rem 4rem;
		min-height: clamp(85vh, 90vw, calc(100vh - var(--navbar-height)));
	}

	.hero-section__text {
		justify-self: center;
		max-width: 30rem;
		color: #fff;
	}

	.hero-badge {
		display: inline-block;
		background: rgba(245, 197, 24, 0.15);
		color: #F5C518;
		padding: 0.4rem 1rem;
		border-radius: 2rem;
		font-size: 0.8rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		margin-bottom: 1.5rem;
		border: 1px solid rgba(245, 197, 24, 0.25);
	}

	.hero-section__text h1 {
		font-size: clamp(2.2rem, 5vw, 3.5rem);
		line-height: 1.1;
		margin-bottom: 1.5rem;
		font-weight: 800;
		color: #fff;
	}

	.hero-section__text p {
		font-size: 1.1rem;
		opacity: 0.85;
		line-height: 1.7;
		margin-bottom: 2rem;
		color: rgba(255,255,255,0.85);
	}

	.hero-btns__container {
		display: flex;
		align-items: center;
		gap: 1rem;
	}

	.hero-section__image {
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.hero-image-wrapper {
		position: relative;
	}

	.hero-image-decoration {
		position: absolute;
		width: 100%;
		height: 100%;
		border: 2px solid rgba(245, 197, 24, 0.3);
		border-radius: var(--theme-shape-radius);
		transform: translate(12px, 12px);
		z-index: 0;
	}

	.hero-image-wrapper picture,
	.hero-section__image img {
		position: relative;
		z-index: 1;
		width: 100%;
		height: 100%;
		max-height: 65vh;
		object-fit: cover;
		border-radius: var(--theme-shape-radius);
		box-shadow: var(--theme-shadow-xl);
	}

	@media (max-width: 768px) {
		.hero-section__content {
			grid-template-columns: 1fr;
			padding: 2rem 1rem;
		}
		.hero-section__image {
			display: none;
		}
		.hero-section__text {
			text-align: center;
			max-width: 100%;
		}
		.hero-btns__container {
			justify-content: center;
		}
	}
</style>
