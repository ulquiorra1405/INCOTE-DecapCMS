---
import { SkipLink } from '@components/odyssey-theme';
import BaseHead from '../components/head/BaseHead.astro';
import type { Props as BaseHeadProps } from '../components/head/BaseHead.astro';

export interface Props {
	seo?: BaseHeadProps;
}

const { seo } = Astro.props;
---

<html lang="es">
	<head>
		<BaseHead {...seo} />
		<script>
			// DETECTAR INVITACIÓN INMEDIATAMENTE: si hay invite_token en la URL,
			// redirigir a /admin/ CONSERVANDO el hash para que el widget lo procese
			(function() {
				var hash = window.location.hash;
				if (hash && hash.indexOf('invite_token') !== -1) {
					window.location.href = '/admin/' + hash;
				}
			})();
		</script>
	</head>
	<body id="body">
		<SkipLink />
    <slot name="announcement-bar" />
		<slot name="header" />
		<main id="content">
			<slot />
		</main>
		<slot name="footer" />
	</body>
</html>
