---
import { SkipLink } from '@components/odyssey-theme';
import BaseHead from '../components/head/BaseHead.astro';
import type { Props as BaseHeadProps } from '../components/head/BaseHead.astro';

export interface Props {
	seo?: BaseHeadProps;
}

const { seo } = Astro.props;
---

<html lang="es">
	<head>
		<BaseHead {...seo} />
		<script src="https://identity.netlify.com/v1/netlify-identity-widget.js"></script>
	</head>
	<body>
		<script>
			// Si el usuario llega con un invite token, redirigirlo a /admin/
			if (window.location.hash && window.location.hash.startsWith('#invite_token')) {
				window.location.href = '/admin/' + window.location.hash;
			}
		</script>
		<SkipLink />
    <slot name="announcement-bar" />
		<slot name="header" />
		<main id="content">
			<slot />
		</main>
		<slot name="footer" />
	</body>
</html>
