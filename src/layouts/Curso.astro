---
import { Container } from '@components/odyssey-theme';
import Layout from './Page.astro';

const { content } = Astro.props;
const {
  titulo,
  categoria,
  descripcion_corta,
  horario,
  duracion,
  modalidad,
  imagen,
  instructor,
  precio_inscripcion,
  precio_mensualidad
} = content;

const seo = {
  title: `${titulo} — INCOTE`,
  description: descripcion_corta,
  image: imagen,
};
---

<Layout seo={seo}>
  <div class="curso-header">
    <Container>
      <div class="curso-header__grid">
        <div class="curso-header__info">
          <span class="curso-badge">{categoria}</span>
          <h1>{titulo}</h1>
          <p class="curso-descripcion">{descripcion_corta}</p>
          <div class="curso-meta">
            {horario && <div class="curso-meta__item">
              <span class="curso-meta__label">Horario</span>
              <span class="curso-meta__value">{horario}</span>
            </div>}
            {duracion && <div class="curso-meta__item">
              <span class="curso-meta__label">Duración</span>
              <span class="curso-meta__value">{duracion}</span>
            </div>}
            {modalidad && <div class="curso-meta__item">
              <span class="curso-meta__label">Modalidad</span>
              <span class="curso-meta__value">{modalidad}</span>
            </div>}
            {instructor && <div class="curso-meta__item">
              <span class="curso-meta__label">Instructor</span>
              <span class="curso-meta__value">{instructor}</span>
            </div>}
          </div>
          {(precio_inscripcion || precio_mensualidad) && <div class="curso-precios">
            {precio_inscripcion && <div class="precio-item">
              <span class="precio-label">Inscripción</span>
              <span class="precio-valor">{precio_inscripcion}</span>
            </div>}
            {precio_mensualidad && <div class="precio-item">
              <span class="precio-label">Mensualidad</span>
              <span class="precio-valor">{precio_mensualidad}</span>
            </div>}
          </div>}
        </div>
        {imagen && <div class="curso-header__img">
          <img src={imagen} alt={titulo} />
        </div>}
      </div>
    </Container>
  </div>

  <Container>
    <article class="curso-content">
      <slot />
    </article>
  </Container>
</Layout>

<style>
  .curso-header {
    padding: var(--section-margin) 0;
    background: var(--theme-surface-1);
  }
  .curso-header__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
    align-items: start;
  }
  .curso-badge {
    display: inline-block;
    background: var(--theme-primary);
    color: var(--theme-on-primary);
    padding: 0.3rem 0.8rem;
    border-radius: 0.25rem;
    font-size: 0.8rem;
    font-weight: 600;
    text-transform: uppercase;
    margin-bottom: 1rem;
  }
  .curso-header__info h1 {
    font-size: 2rem;
    margin-bottom: 1rem;
  }
  .curso-descripcion {
    font-size: 1.1rem;
    opacity: 0.8;
    margin-bottom: 2rem;
    line-height: 1.6;
  }
  .curso-meta {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin-bottom: 2rem;
  }
  .curso-meta__item {
    padding: 0.75rem;
    background: var(--theme-bg);
    border-radius: 0.5rem;
    border: 1px solid rgba(0,0,0,0.08);
  }
  .curso-meta__label {
    display: block;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    opacity: 0.6;
    margin-bottom: 0.25rem;
  }
  .curso-meta__value {
    font-weight: 600;
    font-size: 0.95rem;
  }
  .curso-precios {
    display: flex;
    gap: 1rem;
  }
  .precio-item {
    padding: 0.75rem 1.25rem;
    background: var(--theme-accent);
    color: var(--theme-on-accent);
    border-radius: 0.5rem;
    text-align: center;
    min-width: 120px;
  }
  .precio-label {
    display: block;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    opacity: 0.7;
  }
  .precio-valor {
    display: block;
    font-weight: 700;
    font-size: 1.15rem;
    margin-top: 0.25rem;
  }
  .curso-header__img img {
    width: 100%;
    border-radius: var(--theme-shape-radius);
    object-fit: cover;
    max-height: 400px;
  }
  .curso-content {
    padding: 2rem 0;
    max-width: 800px;
    line-height: 1.8;
  }
  @media (max-width: 768px) {
    .curso-header__grid {
      grid-template-columns: 1fr;
    }
    .curso-meta {
      grid-template-columns: 1fr;
    }
    .curso-precios {
      flex-direction: column;
    }
  }
</style>
